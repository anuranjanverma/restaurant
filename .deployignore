# rsync exclude list for the rishu.dev deployment.
# Consumed by .github/workflows/deploy-rishu-dev.yml via --exclude-from.
# Keep in sync with .gitignore. Never remove an entry without a reason.

# --- Version control / CI ---
.git/
.gitignore
.github/
.gitattributes

# --- Secrets and credentials ---
.env
.env.*
*.pem
*.key
id_rsa
id_rsa.pub
id_ed25519
id_ed25519.pub
deploy-keys/
README-SSH.md
ssh-instructions.txt
*ssh-instructions*

# --- Server-specific config (belongs to the server, not the repo) ---
wp-config.php
wp-config-local.php
.user.ini
.htaccess
.htaccess.local

# --- Media / uploads: user content, not deployable code ---
wp-content/uploads/
*.sql
*.sql.gz
*.tar.gz
*.zip
backups/

# --- Caches and generated files ---
wp-content/cache/
wp-content/upgrade/
wp-content/upgrade-temp-backup/
wp-content/ai1wm-backups/
wp-content/updraft/
wp-content/backup*
wp-content/litespeed/
wp-content/debug.log
cache/
tmp/

# --- Dependencies / build output ---
node_modules/
vendor/
dist/
build/

# --- Logs / OS junk ---
*.log
logs/
dryrun.txt
pending.txt
pending2.txt
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/

# --- Docs are not shippable web content ---
README.md
DEPLOYMENT.md
docs/
scripts/
*.docx
.deployignore